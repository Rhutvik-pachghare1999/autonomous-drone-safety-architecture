# AISP environment configuration — TEMPLATE
#
# Copy to .env and fill in paths for your machine:
#   cp .env.example .env
#
# .env is gitignored. It holds local filesystem paths and tool versions only.
# It contains no API keys, tokens, or credentials. See docs/SECURITY_NOTES.md.
#
# None of these variables are required to run the core HOCBF tests or the
# Python experiments. They document the environment used for the Isaac Sim /
# ROS 2 workflow, which is not runnable in CI (see README "Limitations").

# ROS 2 (only needed for the ROS 2 workflow, not for core tests)
ROS_DISTRO=humble
ROS_ROOT=/opt/ros/humble
ROS_PYTHON_VERSION=3

# NVIDIA Isaac Sim (only needed for sim/quadrotor_rl.py)
ISAAC_SIM_ROOT=/path/to/isaac-sim
ISAAC_SIM_PYTHON=/path/to/isaac-sim/python.sh

# Python
PYTHON_BIN=/usr/bin/python3
PYTHON_VERSION=3.12

# Compilers / build tools
CC=gcc
CXX=g++
CLANG=clang
CMAKE_C_COMPILER=/usr/bin/gcc
CMAKE_CXX_COMPILER=/usr/bin/g++

# Optimization solver
OSQP_INSTALLED=true
OSQP_VERSION=1.1.0

# Optional toolchains
RUST_INSTALLED=false
CARGO_BIN=

# Project paths (relative to the aisp repo root)
AISP_ROOT=.
SRC_DIR=src
CONFIG_DIR=config
SIM_DIR=sim
HARDWARE_DIR=hardware
DOCS_DIR=docs
TESTS_DIR=tests

# Runtime
PYTHONPATH=.:src/control
LD_LIBRARY_PATH=
